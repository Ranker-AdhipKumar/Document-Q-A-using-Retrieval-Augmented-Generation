# ─────────────────────────────────────────────────────────────────────────────
# GEMINI API KEY
# ─────────────────────────────────────────────────────────────────────────────
# 1. Go to https://aistudio.google.com/app/apikey
# 2. Sign in with a Google account (free tier is fine)
# 3. Click "Create API key" → copy the key
# 4. Paste it below, then rename this file to ".env"
# ─────────────────────────────────────────────────────────────────────────────

GEMINI_API_KEY=your_api_key_here

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL SETTINGS (defaults shown)
# ─────────────────────────────────────────────────────────────────────────────

# SQLite database path (stores File Search store name + document history)
DB_PATH=./doc_qa.db

# Maximum number of recent documents to keep in persistence (0 = unlimited)
MAX_PERSISTED_DOCS=20

# Gemini model to use for QA + entity extraction
GEMINI_MODEL=gemini-3.8-flash

# Embedding model for the File Search store
EMBEDDING_MODEL=models/gemini-embedding-2
